# Example secrets file — copy to .streamlit/secrets.toml locally, OR
# paste these values into your Streamlit Cloud app's "Secrets" UI.
# This file is committed for reference; secrets.toml itself is gitignored.

# Optional: a free HuggingFace token raises the unauthenticated rate
# limit from ~3 req/min to ~100 req/min. Get one at
# https://huggingface.co/settings/tokens (the "Read" scope is enough).
#
# Used by download_models.py when the app first fetches the CLIP / BLIP /
# ALIGN weights from HuggingFace. Without it the deploy still works — it
# just hits the lower rate limit and retries automatically.
HF_TOKEN = "hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
